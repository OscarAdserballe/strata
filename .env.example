GEMINI_API_KEY=
# optional: web capture of links
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
STRATA_PORT=8080
# with the updater: where its daily and before-update backups go (writable by uid 1000), and how often it looks
# STRATA_BACKUP_DIR=./backups
# STRATA_UPDATE_EVERY=60
